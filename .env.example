# Gemini API Keys (Comma-separated for multi-key fallback & rotation)
GEMINI_API_KEYS=key1,key2,key3

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Super Admin (Ayah) Phone Number (with country code e.g. 628123456789)
SUPER_ADMIN_PHONE=628123456789

# Google Drive & Google Sheets Integration (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
